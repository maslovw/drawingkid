# Copy to .env on the server. Never commit .env.

OPENAI_API_KEY=sk-...
# Long random string for /v1/admin/* (grant stars, stats): openssl rand -hex 32
ADMIN_TOKEN=

# Image generation (defaults shown). Square, low quality keeps a page around $0.01-0.03.
PROVIDER=openai
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=low
IMAGE_SIZE=1024x1024
MODERATE_IMAGES=1

# Spending
DAILY_CAP_USD=20
WORST_IMAGE_USD=0.03
IMAGES_PER_HOUR=30
# Gets {"text": "..."} at 80% and 100% of the daily cap.
ALERT_WEBHOOK_URL=

# Retention
PROMPT_RETENTION_HOURS=24
IDEA_RETENTION_DAYS=7

# App Store
BUNDLE_ID=com.maslovw.drawingkid
APPSTORE_ENVIRONMENTS=Production,Sandbox
# Stars a family-shared Full Studio brings (open question in handover.md).
FAMILY_SHARED_STARS=0

# DeviceCheck (free star once per iPad). Without it, free stars are refused.
APPLE_TEAM_ID=
DEVICECHECK_KEY_ID=
DEVICECHECK_KEY_PATH=/secrets/devicecheck.p8
DEVICECHECK_DEVELOPMENT=0
